# ---------- LLM ----------
# Chat model provider: openai | anthropic | bedrock
LLM_PROVIDER=openai
LLM_MAX_TOKENS=400

OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL_ID=gpt-4o-mini

ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL_ID=claude-haiku-4-5

AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0

# ---------- Embeddings ----------
# openai | bedrock  (changing it needs a re-ingest)
EMBEDDING_PROVIDER=openai
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
BEDROCK_EMBEDDING_MODEL=amazon.titan-embed-text-v2:0

# ---------- Retrieval ----------
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=4
MIN_RELEVANCE=0.3
HISTORY_TURNS=3

# ---------- Document source ----------
# wiki = Northwind Wiki REST API | files = data/docs folder
DOCS_SOURCE=wiki
WIKI_BASE_URL=http://127.0.0.1:8088
WIKI_PUBLIC_URL=http://127.0.0.1:8088
WIKI_API_TOKEN=your-generated-wiki-token

# ---------- RAG API ----------
RAG_API_URL=http://127.0.0.1:8000
RAG_API_TOKEN=your-generated-rag-token
INGEST_ON_STARTUP=false

# ---------- Wiki ----------
# Re-ingest after every page save
WIKI_AUTO_SYNC=true
# Chat rate limits per user + IP (0 = unlimited)
CHAT_RATE_PER_MINUTE=10
CHAT_RATE_PER_DAY=200
